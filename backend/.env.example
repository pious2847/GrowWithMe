# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/growwithme

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=60d

# Arkesel SMS (https://sms.arkesel.com) - leave API key empty in dev to log SMS to console instead of sending
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=GrowWithMe

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP
OTP_TTL_MINUTES=10

# NVIDIA NIM (free API key from https://build.nvidia.com) - powers the Nana assistant
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Google Maps Platform (free monthly credit) - emergency "closest hospital" lookup
GOOGLE_MAPS_API_KEY=

# ElevenLabs (free tier from https://elevenlabs.io) - natural voice for Nana
# Voice must be a PREMADE voice on free plans (library voices need a paid plan).
# Default: Sarah (mature, reassuring). List yours: GET /v1/voices
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
