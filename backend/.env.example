# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/growwithme

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_EXPIRES=60d

# Arkesel SMS (https://sms.arkesel.com) - leave API key empty in dev to log SMS to console instead of sending
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=GrowWithMe

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OTP
OTP_TTL_MINUTES=10
