{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growwithme.app/schema/action_trajectory.schema.json",
  "title": "GrowWithMe action trajectory",
  "description": "One caregiver episode: observations of the app screen and the actions taken. Values are synthetic; the corpus contains no real personal data.",
  "type": "object",
  "required": [
    "episodeId", "generatorVersion", "graphVersion", "seed", "persona",
    "country", "locale", "language", "goal", "goalDescription", "intents",
    "startScreen", "finalScreen", "outcome", "device", "steps", "split"
  ],
  "additionalProperties": false,
  "properties": {
    "episodeId": { "type": "string", "minLength": 8 },
    "generatorVersion": { "type": "string" },
    "graphVersion": { "type": "string" },
    "seed": { "type": "integer", "minimum": 0 },
    "persona": {
      "type": "string",
      "enum": [
        "first_time_mother", "experienced_mother", "low_literacy_caregiver",
        "community_health_worker", "high_risk_pregnancy",
        "diaspora_supporter", "multilingual_caregiver"
      ]
    },
    "personaLabel": { "type": "string" },
    "country": { "type": "string", "enum": ["GH", "NG", "KE", "UG", "TZ"] },
    "locale": { "type": "string" },
    "language": { "type": "string" },
    "goal": { "type": "string" },
    "goalDescription": { "type": "string" },
    "intents": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "startScreen": { "type": "string" },
    "finalScreen": { "type": "string" },
    "outcome": {
      "type": "object",
      "required": ["completed", "success", "stepCount", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "completed": { "type": "boolean" },
        "success": { "type": "boolean" },
        "stepCount": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "device": {
      "type": "object",
      "required": ["platform", "appVersion", "locale"],
      "additionalProperties": false,
      "properties": {
        "platform": { "type": "string", "enum": ["android", "ios"] },
        "appVersion": { "type": "string" },
        "locale": { "type": "string" }
      }
    },
    "split": { "type": "string", "enum": ["train", "val", "test"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["stepId", "observation", "action", "outcome", "durationMs"],
      "additionalProperties": false,
      "properties": {
        "stepId": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "observation": { "$ref": "#/$defs/observation" },
        "action": { "$ref": "#/$defs/action" },
        "outcome": {
          "type": "object",
          "required": ["success", "nextScreen"],
          "additionalProperties": false,
          "properties": {
            "success": { "type": "boolean" },
            "error": { "type": "string" },
            "nextScreen": { "type": "string" }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "required": ["screen", "screenTitle", "elements", "scrollable", "scrolled", "state", "stepIndex"],
      "additionalProperties": false,
      "properties": {
        "screen": { "type": "string" },
        "screenTitle": { "type": "string" },
        "tab": { "type": ["string", "null"] },
        "scrollable": { "type": "boolean" },
        "scrolled": { "type": "boolean" },
        "stepIndex": { "type": "integer", "minimum": 0 },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        },
        "state": {
          "type": "object",
          "required": ["country", "language", "childCount", "pregnant", "offline", "network", "firstRun", "consented", "appVersion"],
          "additionalProperties": false,
          "properties": {
            "country": { "type": "string" },
            "language": { "type": "string" },
            "childCount": { "type": "integer", "minimum": 0 },
            "pregnant": { "type": "boolean" },
            "offline": { "type": "boolean" },
            "network": { "type": "string" },
            "firstRun": { "type": "boolean" },
            "consented": { "type": "boolean" },
            "appVersion": { "type": "string" }
          }
        }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "label", "kind", "box"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["button", "field", "chip", "row", "card", "icon", "toggle",
                   "select", "checkbox", "segmented", "fab", "avatar", "nav", "text", "app"]
        },
        "box": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["tap", "long_press", "type", "scroll", "swipe", "back", "speak",
                   "toggle", "call", "send_sms", "set_alarm", "share_location", "open_app"]
        },
        "target": { "type": ["string", "null"] },
        "label": { "type": "string" },
        "value": { "type": ["string", "null"] },
        "valueKind": { "type": "string" },
        "direction": { "type": "string", "enum": ["up", "down", "left", "right"] },
        "amount": { "type": "number", "minimum": 0, "maximum": 1 },
        "holdMs": { "type": "integer", "minimum": 0 },
        "coords": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 },
              "minItems": 2,
              "maxItems": 2
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "number", "minimum": 0, "maximum": 1 },
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        }
      }
    }
  }
}
